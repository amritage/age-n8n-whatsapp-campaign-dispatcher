    {
      "id": "bc000000-0000-4000-8000-500000000005",
      "name": "Summarize Recorded Operational State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const control=$('Data Table - Read Portfolio Control').all().map(i=>i.json).filter(x=>x&&Object.keys(x).length);\nconst events=$input.all().map(i=>i.json).filter(x=>x&&Object.keys(x).length);\nif(control.some(x=>x.error)||events.some(x=>x.error))\n return [{json:{mode:'READ_ONLY',result:'BLOCKED',reason:'DATA_TABLE_UNAVAILABLE',canSend:false}}];\nif(control.length>50||events.length>3000)throw new Error('DATA_TABLE_REPORTING_VOLUME_EXCEEDED');\nconst d=new Map();\nfor(const x of events){\n const st=String(x.state||'UNKNOWN');\n const count=x.count==null?1:Number(x.count);\n if(!Number.isSafeInteger(count)||count<0)throw new Error('INVALID_EVENT_COUNT');\n d.set(st,(d.get(st)||0)+count);\n}\nreturn [{json:{checkedAt:new Date().toISOString(),mode:'READ_ONLY',result:'RECORDED_ACTIVITY_ONLY',\n portfolios:control.length,recordedEventRows:events.length,\n recordedStates:[...d].map(([state,count])=>({state,count})),\n providerReceiptsVerified:false,atomicReservationEnabled:false,canSend:false,\n note:'No per-recipient PII, no claims of complete delivery or rolling Meta availability'}}];"
      },
